---
import "../style/global.css"

const {h2, p} = Astro.props;

---

<div class="round-card">
    <div class="text"> 
    <h2>{h2}</h2>
    <p>{p}</p>
    </div>
</div>

<style>

    .round-card{
        border: 2px solid var( --blue-700);
        box-shadow: 6px 6px var(--blue-500);
        border-radius: 50%;
        width: 300px;
        height: 300px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 20px;
        margin-block: 25px;
        justify-self: center;
    }

    p{
        font-size: 1rem;
    }

    h2{
        font-family: var(--font-serif);
        font-weight: var(--font-weight-light-italic);
        font-size: 1.5rem;
        letter-spacing: var(--spacing-3);
        line-height: var(--height-125);
        margin-bottom: 10px;
    }

    .text{
        max-width: 200px;
        padding: 20px;
    }
    



</style>
