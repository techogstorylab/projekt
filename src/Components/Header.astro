---

import "../style/global.css";

const headLogo = "../assets/logo_header.svg";

---

<header>
    <div class="flex_header">
    <a href="/"><img src={headLogo} alt="Logo"></a>
    <div class="dropdown">
    <button class="dropbtn">Menu</button>
    <div class="dropdown-content">
        <a href="#"><span>Studier</span></a>
        <a href="#"><span>Udstyr & tilbehør</span></a>
        <a href="#"><span>Workshops & events</span></a>
        <a href="#"><span>Information om labbet</span></a>
    </div>
    </div>
    </div>
</header>

<style>

img {
    width: 300px;
}

header {
    background-color: var(--color-gul-50);
    border-bottom: solid 1px var(--color-grey);
    box-shadow: 0 2 4 1px rgba(0, 0, 0, 0.055);
    padding-block: 22px;
    padding-inline: 30px;
}

.flex_header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

/* Dropdown Menu */
    .dropdown {
  position: relative;
}

/* Style the dropdown button */
.dropbtn {
    color: var(--pink-950);
  background-color: var(--koral-100);
  border: solid 12px var(--color-gul-50);
  box-shadow: 0 0 0 2px var(--koral-500), 3.5px 3.5px 0px 2px var(--koral-300);
  border-radius: 3px;
  padding-block: 12px;
  padding-inline: 40px;
  cursor: pointer;
}

/* Dropdown content */
.dropdown-content {
  display: none;
  position: absolute;
  background-color: var(--koral-100);
  padding-bottom: 20px;
  width: max-content;
  right: 0;
  top: 93px;
  border-radius: 3px;
  box-shadow: 0 0 0 2px var(--koral-500), 3.5px 3.5px 0px 2px var(--koral-300), 0px 0px 10px 0px var(--color-grey);
}

.dropdown-content::before {
  content: "";
  position: absolute;
  top: -30px; /* Reaches upward across your 93px gap area */
  left: 0;
  width: 100%;
  height: 30px; /* Height of the bridge zone */
  background: transparent; /* Completely invisible */
}

/* Links inside dropdown content */
.dropdown-content a {
  color: var(--color-sort);
  padding-block: 20px 3px;
  padding-inline: 25px 25px;
  text-decoration: none;
  display: block;
}

.dropdown-content a span {
  display: inline-block;
  border-bottom: solid 1.35px var(--koral-300);
  width: 300px;
}

/* Change color of dropdown links on hover */
.dropdown-content a:hover {
  background-color: var(--koral-300);
  border-radius: 2px;
}

/* Show the dropdown content on hover */
.dropdown:hover .dropdown-content {
  display: block;
}

/* Change background color of dropdown button on hover */
.dropdown:hover .dropbtn {
  background-color: var(--koral-300);
}
</style>