---
const {data} = Astro.props;

// HUSK at importere global css
---

<!-- Vi filtrere efter navn, fordi vi ved at det er unikt -->

<article>
     <!-- fordi vi har ændrer vores props til at være hele objektet ved at skrive data, 
         skal vi lige specificerer hvor vi skal finde vores enkelte variabler ved at bruge dot notation til at skrive data.image -->

     <!-- det første step til at lave vores undersider er at tilføje et link. 
       Vi vil gerne have en mappe hvor vi har vores undersider, så derfor skriver vi "/"
       og så vil vi gerne have de peger til hver deres side
       det er vigtigt at hver side har hver deres unikke navn, og det vi indtil videre ved er unikt er det name hvert objekt har
       så vi skriver `/udstyr/${data.name}`
       så nu står der; når vi klikker på linket kommer vi til roden og så ind i en mappe der hedder udstyr og ind på en side med et unikt name
       
       næste skridt er vi under pages laver e nfiolder vi kalder udstyr, som vi skal have lavet vores single pages i, 
       vi laver kun én og så sørger astro for at det bliver flere sider for os ved at vi tilføjer [] rundt om navnet (gå derind nu)
       -->
    <a href=`/udstyr/${data.name}`>
    <img src={data.image} alt={data.name}>
    <p class="subheader">{data.name}</p>
    </a>
</article>


<style>
    article{
        width: 400px;
        height: auto;
        background-color: pink;
        display: grid;
        grid-template-rows: 12fr 0.5fr;
        margin-bottom: 40px;
        justify-self: center;
        box-shadow: 6px 6px blue;
        border: 1px solid blue;
        border-radius: 3%;
        padding: 5px;
    }

    img{
        width: 100%;
        grid-row: 1;
        border-radius: 3%;
    }

    a{
        display: block;
    }

    .subheader {
        display: flex;
        align-content: center;
        grid-row: 2;
        padding: 5px;
    }


</style>