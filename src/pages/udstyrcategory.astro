---
import Layout from "../layout/Layout.astro";

import Back from "../Components/Back.astro";

import RoundCard from "../Components/RoundCard.astro";

import "../style/global.css"

---

<Layout title="Udstyr og tilbehør">

    <Back/>

    <section class="hero-section">
		<div class="hero">
			<h1>
				Udstyr og tilbehør<br>
				<span>Tech & Story Lab</span>
			</h1>
            <div class="streg"></div>
			<p class="subheader">Her finder du et bredt udvalg af udstyr, du kan låne. Vælg en kategori, brows vores udstyr, og tjek til slut om udstyret er ledigt, og smut så derefter ned til os i labbet og lån det! </p>
		</div>
		<img src="/public/assets/illustrationer-elementer/udstyr.svg" alt="Illustration af en mand der viser udstyr han har i sin jakke">
	</section>

    <section class="cards">

        <a href="/udstyrlist">
            <div class="card-1"> 
                <RoundCard h2="Foto, video, lyd og lys" p="Find alt fra kameraer, objektiver og stabilisatorer til tripods, mikrofoner og lysudstyr."/>
            </div>
        </a>


        <div class="card-2"> 
        <RoundCard h2="Tilbehør til udstyr" p="Få det meste ud af dit udstyr med et udvalg af kabler, adaptere, strømforsyninger og lagringsmuligheder."/>
        </div>

        <div class="card-3"> 
        <RoundCard h2="Teknologi og innovation" p="Dyk ned i den nyeste teknologi med alt fra virtual reality og IoT til kunstig intelligens og programmerbare enheder."/>
        </div>

        <div class="card-4"> 
        <RoundCard h2="Mobile enheder og computere" p="Uanset om du skal bruge en smartphone, tablet eller computer, finder du her digitale værktøjer til dine projekter."/>
        </div>

    </section>

</Layout>

<style>

    .hero-section{
        margin-inline: 50px;
        display: flex;
    }
    h1 {
        font-size: 2rem;
        margin-top: 40px ; 
    }

    h1 span{
        font-size:  2rem;
    }

    .streg{
        height: 5px;
        background-color: var(--pink-950);
        margin-block: 5px 10px;
    }

    .subheader{
        font-size: 1rem;
        margin-bottom: 40px;
    }

    .hero-section img{
        margin-right: -50px;
        margin-left: 25px;
    }

    p{
        font-size: 1rem;
    }

    @media(min-width:800px){
        .hero-section img{
            width: 635px;
        }

        h1{
            font-size: var(--h1-size-sans);
            width: 750px;
        }

        h1 span{
            font-size: var(--h1-size-serif);
            display: block;
            text-align: right;
        }

        .subheader{
            font-size: var(--subheader-size);
        }

        .streg{
            width: 800px;
            margin-block: 10px 30px;
        }

        p{
            max-width: 800px;
        }

        .cards{
            display: grid;
            grid-template-columns: 1fr 1fr;
            grid-template-rows: 1fr 1fr 1fr 1fr 1fr;
            width: fit-content;
            justify-self: center;
            margin-top: -100px;
            gap: 100px;
        }

        .card-1{
            grid-column: 1;
            grid-row: 1/3;
        }

         .card-2{
            grid-column: 2;
            grid-row: 2/4;
         }

          .card-3{
            grid-column: 1;
            grid-row: 3/5;
          }

           .card-4{
            grid-column: 2;
            grid-row: 4/6;
           }


        
    }


    

</style>